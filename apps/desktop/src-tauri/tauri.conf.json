{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZORIX",
  "version": "0.1.0",
  "identifier": "dev.zorix.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ZORIX",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Run AI activities under control",
    "longDescription": "ZORIX is an open-source harness for AI: it runs activities with explicit permissions, human approval, limits, checkpoints and a complete record, whichever model does the thinking.",
    "copyright": "MIT License - ZORIX contributors",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
